{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.csr.html",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets-estaticos",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/static/**",
          "/assets/juan_*",
          "/assets/subzonas_magdalena_cauca.csv"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "datos-hidrologicos-frescos",
      "urls": [
        "/**/assets/fews_calamar.json*",
        "/**/assets/nivel_calamar.csv*",
        "/**/assets/config_alertas.json*",
        "/**/api/**",
        "https://raw.githubusercontent.com/**/PROYECTO_JUAN/**"
      ],
      "cacheConfig": {
        "maxSize": 30,
        "maxAge": "1h",
        "timeout": "4s",
        "strategy": "freshness"
      }
    }
  ]
}
